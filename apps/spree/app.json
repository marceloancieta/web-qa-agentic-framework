{
  "name": "spree",
  "version": "6.0.3",
  "title": "Spree Commerce admin",
  "login_path": "/dashboard/login",
  "breakpoints": { "sidebar": 768, "settings_navigation": 1024 },
  "third_party_hosts": [],
  "secret_keys": [],
  "identity_fields": [],
  "visual": { "stylePath": "visual.css" },
  "a11y_sweep": { "ready": "headings", "exclude": ["iframe[title=\"Email preview\"]"] },
  "app_map": {
    "start": ["/", "/dashboard/login", "/dashboard/forgot-password"],
    "session_writes": ["POST /api/v3/admin/auth/refresh"],
    "exclude": ["#main-content$", "/logout", "/sign-out", "^/store_", "^/rails/"],
    "actors": {
      "admin": {
        "start": ["/dashboard"]
      }
    }
  }
}
