# Environment template. Copy to .env and fill in. NEVER commit .env or put real values here.

# Which qa-config environment to target (overrides app.default_environment).
QA_ENV=local

# Optional: override one pack's base_url for a one-off run. The name is QA_<PACK>_BASE_URL, pack
# upper-cased and hyphens as underscores.
# QA_JUICE_SHOP_BASE_URL=

# Optional: milliseconds the browser waits before each action, to follow a headed run by eye
# (npx playwright test --headed --workers=1). Unset or 0 is full speed; the test timeout grows with it.
# QA_SLOWMO=800

# SauceDemo pack: the demo account behind the "standard" actor. Its user names and password are
# shown on the application's own login page.
SAUCEDEMO_STANDARD_USER=
SAUCEDEMO_PASSWORD=
