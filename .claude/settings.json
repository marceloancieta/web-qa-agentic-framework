{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(printenv)",
      "Bash(env)",
      "Bash(set)",
      "Read(~/.ssh/**)",
      "Read(**/credentials*)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(**/*.pfx)",
      "Read(**/*.p12)",
      "Read(**/.auth/**)",
      "Edit(~/.ssh/**)",
      "Edit(**/credentials*)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Edit(**/*.key)",
      "Edit(**/*.pem)",
      "Edit(**/*.pfx)",
      "Edit(**/*.p12)",
      "Edit(**/.auth/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/session-probe.mjs"],
            "timeout": 30,
            "statusMessage": "Checking setup and application availability"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/secret-guard.mjs"],
            "timeout": 10,
            "statusMessage": "Looking for credentials in the prompt"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/secret-guard.mjs"],
            "timeout": 10,
            "statusMessage": "Looking for credentials in the tool call"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/git-policy.mjs"],
            "timeout": 10,
            "statusMessage": "Applying commit and pull-request rules"
          }
        ]
      },
      {
        "matcher": "mcp__.*playwright.*__browser_.*|mcp__claude-in-chrome__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/browser-guard.mjs"],
            "timeout": 10,
            "statusMessage": "Checking the browser limits of design"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/secret-guard.mjs"],
            "timeout": 10,
            "statusMessage": "Masking credentials in the tool output"
          }
        ]
      }
    ]
  }
}
