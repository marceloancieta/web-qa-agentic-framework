{
  "$schema": "./schemas/qa-config.schema.json",
  "project": {
    "name": "web-qa-example"
  },
  "app": {
    "default_environment": "local",
    "environments": {
      "local": {
        "projects": ["desktop-chromium", "mobile-chrome"],
        "packs": {
          "juice-shop": {
            "base_url": "http://localhost:3000",
            "allow_writes": true,
            "recovery": { "command": "docker compose -f docker/compose.yml restart juice-shop" },
            "actors": {
              "customer": { "account": "provisioned" }
            },
            "performance": {
              "web_vitals": {
                "samples": 5,
                "budgets": {
                  "default": { "lcp_ms": 2500, "cls": 0.1, "inp_ms": 200 },
                  "mobile-chrome": { "lcp_ms": 3000 }
                }
              },
              "lighthouse": {
                "routes": ["/#/search", "/#/login"],
                "runs": 3,
                "min_scores": {
                  "desktop": { "performance": 80, "accessibility": 85, "best-practices": 90 },
                  "mobile": { "performance": 30, "accessibility": 85, "best-practices": 90 }
                }
              }
            }
          },
          "saucedemo": {
            "base_url": "https://www.saucedemo.com",
            "allow_writes": false,
            "actors": {
              "standard": {
                "account": "existing",
                "username_env": "SAUCEDEMO_STANDARD_USER",
                "password_env": "SAUCEDEMO_PASSWORD"
              },
              "locked-out": {
                "account": "existing",
                "username_env": "SAUCEDEMO_LOCKED_OUT_USER",
                "password_env": "SAUCEDEMO_PASSWORD"
              },
              "performance-glitch": {
                "account": "existing",
                "username_env": "SAUCEDEMO_PERFORMANCE_GLITCH_USER",
                "password_env": "SAUCEDEMO_PASSWORD"
              },
              "visual": {
                "account": "existing",
                "username_env": "SAUCEDEMO_VISUAL_USER",
                "password_env": "SAUCEDEMO_PASSWORD"
              }
            },
            "default_actor": "standard",
            "performance": {
              "web_vitals": {
                "samples": 3,
                "budgets": {
                  "default": { "lcp_ms": 2000, "cls": 0.05, "inp_ms": 100 }
                }
              },
              "lighthouse": {
                "routes": ["/"],
                "runs": 1,
                "min_scores": {
                  "desktop": { "performance": 85, "accessibility": 90, "best-practices": 70 }
                }
              }
            }
          }
        }
      },
      "ci": {
        "projects": [
          "desktop-chromium",
          "desktop-firefox",
          "desktop-webkit",
          "tablet",
          "mobile-chrome",
          "mobile-safari"
        ],
        "pairwise": true,
        "packs": {
          "juice-shop": {
            "base_url": "http://localhost:3000",
            "allow_writes": true,
            "recovery": { "command": "docker compose -f docker/compose.yml restart juice-shop" },
            "actors": {
              "customer": { "account": "provisioned" }
            },
            "performance": {
              "web_vitals": {
                "samples": 5,
                "budgets": {
                  "default": { "lcp_ms": 2500, "cls": 0.1, "inp_ms": 200 },
                  "mobile-chrome": { "lcp_ms": 3000 }
                }
              },
              "lighthouse": {
                "routes": ["/#/search", "/#/login"],
                "runs": 3,
                "min_scores": {
                  "desktop": { "performance": 70, "accessibility": 85, "best-practices": 90 },
                  "mobile": { "performance": 20, "accessibility": 85, "best-practices": 90 }
                }
              }
            }
          }
        }
      }
    },
    "accessibility": {
      "tags": ["wcag2a", "wcag2aa", "wcag21aa"]
    }
  },
  "test_management": {
    "provider": "local",
    "options": { "dir": "reports/tm/local" }
  },
  "tracker": {
    "provider": "local",
    "options": { "dir": "docs/tracker/local" },
    "key_pattern": "LOCAL-\\d+",
    "base_url": null,
    "issue_url": "docs/tracker/local/issues.json#{key}"
  },
  "policies": {
    "commit": {
      "require_tracker_key": false,
      "max_tracker_keys": 1,
      "conventional_commits": true,
      "protected_branches": []
    },
    "pull_request": {
      "required_labels": []
    }
  },
  "quality_gate": {
    "pass_rate": { "fail_below_pct": 90, "review_below_pct": 100 },
    "accessibility": {
      "fail_above": { "critical": 0, "serious": 0 },
      "review_above": { "moderate": 0 }
    },
    "visual": { "fail_above": 0 },
    "mutation": { "fail_below_pct": 65, "review_below_pct": 80 }
  }
}
