{
  "name": "web-qa-agentic-framework",
  "version": "0.0.0",
  "description": "Agentic web UI QA framework: phase-gated test design, Playwright + TypeScript execution across browsers and devices, pluggable test-management adapters, Claude Code skills and guardrails.",
  "license": "Apache-2.0",
  "author": "Marcelo Ancieta",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check --cache --cache-strategy content .",
    "types:check": "tsc -p .",
    "config:check": "node scripts/config-check.mjs --all",
    "test:hooks": "node --test \".claude/hooks/__tests__/*.test.mjs\"",
    "test:scripts": "node scripts/test-scripts.mjs",
    "test:unit": "playwright test --project=unit",
    "test": "playwright test",
    "lint:layers": "node scripts/lint-layers.mjs",
    "lint:self-test": "node scripts/lint-layers.mjs --self-test",
    "lint:qa": "npm run lint:layers && npm run lint:self-test",
    "scan:denylist": "node scripts/scan-denylist.mjs --tracked",
    "scan:denylist:history": "node scripts/scan-denylist.mjs --history",
    "scan:denylist:self-test": "node scripts/scan-denylist.mjs --self-test",
    "scan:secrets": "node scripts/secret-scan.mjs --history",
    "hooks:install": "git config core.hooksPath .githooks",
    "commit:title": "node scripts/commit-title.mjs",
    "changelog": "node scripts/changelog.mjs --next",
    "changelog:write": "node scripts/changelog.mjs --next --write",
    "gates": "npm run lint && npm run format:check && npm run types:check && npm run config:check && npm run test:hooks && npm run test:scripts && npm run lint:qa && npm run test:unit && npm run scan:denylist:self-test && npm run scan:denylist && npm run scan:secrets"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}
