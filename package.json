{
  "name": "web-qa-agentic-framework",
  "version": "0.0.0",
  "description": "Agentic web UI QA framework: phase-gated test design, Playwright + TypeScript execution across browsers and devices, pluggable test-management adapters, Claude Code skills and guardrails.",
  "license": "Apache-2.0",
  "author": "Marcelo Ancieta",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check --cache --cache-strategy content .",
    "types:check": "tsc -p .",
    "config:check": "node scripts/config-check.mjs --all",
    "test:hooks": "node --test \".claude/hooks/__tests__/*.test.mjs\"",
    "test:scripts": "node scripts/test-scripts.mjs",
    "test:unit": "playwright test --project=unit",
    "test": "playwright test",
    "juice-shop:up": "docker compose -f docker/compose.yml up -d --wait juice-shop",
    "juice-shop:down": "docker compose -f docker/compose.yml rm --stop --force juice-shop",
    "lanes:visual": "docker compose -f docker/compose.yml run --rm playwright node scripts/visual-lane.mjs",
    "lanes:mocked": "node scripts/lanes.mjs mocked",
    "lanes:known-gap": "node scripts/lanes.mjs known-gap",
    "lanes:destructive": "node scripts/lanes.mjs destructive",
    "lanes:flake": "node scripts/lanes.mjs flake",
    "lanes:a11y": "node scripts/lanes.mjs a11y",
    "test:smoke": "playwright test --grep @smoke",
    "scaffold:app": "node scripts/scaffold-app.mjs",
    "app:map": "node scripts/app-map.mjs",
    "app:map:check": "node scripts/app-map.mjs --check",
    "lint:layers": "node scripts/lint-layers.mjs",
    "lint:harness": "node scripts/lint-harness.mjs",
    "lint:docs": "node scripts/lint-docs.mjs",
    "lint:docs:history": "node scripts/lint-docs.mjs --history",
    "lint:suite": "node scripts/lint-suite.mjs",
    "lint:self-test": "node scripts/lint-layers.mjs --self-test && node scripts/lint-harness.mjs --self-test && node scripts/lint-docs.mjs --self-test && node scripts/lint-suite.mjs --self-test",
    "lint:qa": "npm run lint:layers && npm run lint:harness && npm run lint:docs && npm run lint:suite && npm run lint:self-test",
    "coverage:status": "node scripts/coverage-status.mjs",
    "traceability": "node scripts/traceability.mjs",
    "quality:gate": "node scripts/quality-gate.mjs --summary reports/quality-gate.md",
    "pairwise": "node scripts/pairwise.mjs",
    "framework:update": "node scripts/framework-update.mjs",
    "remove:app": "node scripts/remove-app.mjs",
    "mutation": "stryker run && stryker run stryker.hooks.config.mjs && npm run mutation:gate",
    "mutation:gate": "node scripts/quality-gate.mjs --mutation reports/mutation/scripts-lib.json --mutation reports/mutation/hooks-lib.json --summary reports/mutation/quality-gate.md",
    "ci:merge": "node scripts/ci-merge.mjs",
    "ci:needs": "node scripts/ci-needs.mjs",
    "ci:browsers": "playwright install --with-deps chromium firefox webkit",
    "tm:manifest": "node scripts/tm/manifest.mjs",
    "tm:publish": "node scripts/tm/run.mjs publish",
    "tm:report": "node scripts/tm/run.mjs report",
    "report:html": "allure generate allure-results --output reports/allure-report",
    "tracker": "node scripts/tracker/cli.mjs",
    "scan:denylist": "node scripts/scan-denylist.mjs --tracked",
    "scan:denylist:history": "node scripts/scan-denylist.mjs --history",
    "scan:denylist:self-test": "node scripts/scan-denylist.mjs --self-test",
    "scan:secrets": "node scripts/secret-scan.mjs --history",
    "audit:deps": "node scripts/audit-deps.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "commit:title": "node scripts/commit-title.mjs",
    "changelog": "node scripts/changelog.mjs --next",
    "changelog:write": "node scripts/changelog.mjs --next --write",
    "gates": "npm run lint && npm run format:check && npm run types:check && npm run config:check && npm run test:hooks && npm run test:scripts && npm run lint:qa && npm run coverage:status && npm run traceability && npm run test:unit && npm run scan:denylist:self-test && npm run scan:denylist && npm run scan:denylist:history && npm run lint:docs:history && npm run scan:secrets"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/tap-runner": "^10.1.1",
    "@types/node": "^22.20.5",
    "adm-zip": "^0.6.1",
    "allure": "^3.22.1",
    "allure-js-commons": "^3.14.0",
    "allure-playwright": "^3.14.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "dompurify": "3.4.17",
    "qs": "6.16.1"
  }
}
